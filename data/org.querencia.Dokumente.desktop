[Desktop Entry]
# Querencia Dokumente. Desktop-ID = GApplication-ID org.querencia.Dokumente,
# damit labwc und die Fensterliste das Fenster dieser Datei zuordnen.
# Vorlage: Name, GenericName, Comment und Keywords sind englisch; die
# Übersetzungen (Name[de]= …) setzt `werkzeug/i18n.py desktop` aus po/*.po
# ein (entspricht msgfmt --desktop). Erzeugt: org.querencia.Dokumente.desktop.
# Menüname „Document Viewer“/„Dokumentenbetrachter“ unter Büro wie Evince;
# der Fenstertitel bleibt „… – Querencia Dokumente“. Querencia Dokumente
# schreibt nie in Dokumente. Symbole ohne 48x48 (GTK-4.22-Symbolregel).
Type=Application
Version=1.5
Name[de]=Dokumentenbetrachter
Name[es]=Visor de documentos
Name[fr]=Visionneur de documents
Name[it]=Visualizzatore documenti
Name=Document Viewer
GenericName[de]=Dokumentenbetrachter
GenericName[es]=Visor de documentos
GenericName[fr]=Visionneur de documents
GenericName[it]=Visualizzatore documenti
GenericName=Document Viewer
Comment[de]=PDF-Dokumente ansehen
Comment[es]=Ver documentos PDF
Comment[fr]=Voir des documents PDF
Comment[it]=Visualizza documenti PDF
Comment=View PDF documents
Exec=querencia-dokumente %U
TryExec=querencia-dokumente
Icon=org.querencia.Dokumente
Terminal=false
Categories=GTK;Office;Viewer;
MimeType=application/pdf;
Keywords[de]=PDF;Dokument;Betrachter;Dokumentenbetrachter;
Keywords[es]=PDF;Documento;Visor;Lector;
Keywords[fr]=PDF;Document;Visionneur;Lecteur;
Keywords[it]=PDF;Documento;Visualizzatore;Lettore;
Keywords=PDF;Document;Viewer;Reader;
StartupNotify=true
StartupWMClass=org.querencia.Dokumente
